# Environment variables for Tclaw Telegram Bot

# ============================================================================
# LLM CONFIGURATION (Config-driven: can switch providers without code changes)
# ============================================================================

# Provider options: "openai", "anthropic", "local"
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# Alternative: Anthropic Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# ============================================================================
# TELEGRAM CONFIGURATION
# ============================================================================

# Get your bot token from BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Optional: Use webhook instead of polling (production recommended)
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook
# TELEGRAM_POLLING_TIMEOUT=30

# ============================================================================
# GITHUB CONFIGURATION (For issue creation tool)
# ============================================================================

GITHUB_TOKEN=ghp_your-token-here
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=your-repo

# ============================================================================
# NOTION CONFIGURATION (For page creation tool)
# ============================================================================

NOTION_API_KEY=ntn_your-key-here
NOTION_DATABASE_ID=your-database-id

# ============================================================================
# RAG CONFIGURATION (Vector store & indexing)
# ============================================================================

# Path to Chroma vector store (local, file-based)
RAG_CHROMA_PATH=./data/rag

# How often to re-index messages: "hourly", "daily", "weekly"
RAG_INDEX_FREQUENCY=daily

# How many days back to index (min 1, max 365)
RAG_LOOKBACK_DAYS=30

# Max messages to index per group (prevents huge indexes)
RAG_MAX_MESSAGES_PER_GROUP=200

# ============================================================================
# MEMORY CONFIGURATION
# ============================================================================

# Base path for memory files (MEMORY.md, daily logs, profiles, etc.)
MEMORY_DATA_PATH=./data/memory

# What time to run daily memory digest (HH:mm in 24-hour format)
MEMORY_DAILY_DIGEST_TIME=09:00

# ============================================================================
# SCHEDULER CONFIGURATION
# ============================================================================

# User timezone for cron jobs (e.g., "UTC", "America/New_York", "Asia/Tokyo")
SCHEDULER_TIMEZONE=UTC

# ============================================================================
# LOGGING & DEBUG
# ============================================================================

# Log level: "debug", "info", "warn", "error"
LOG_LEVEL=info

# Enable verbose debug logging
DEBUG=false

# ============================================================================
# DEVELOPMENT / PRODUCTION
# ============================================================================

NODE_ENV=development
